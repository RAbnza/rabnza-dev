# Set only after choosing the final production origin, without a trailing path.
# PUBLIC_SITE_URL=https://your-portfolio-domain.example
# Vercel supplies VERCEL_ENV. Preview builds remain noindex even with an origin.

# Browser-safe EmailJS identifiers. NEVER put a private API key or SMTP password here.
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=
PUBLIC_EMAILJS_PUBLIC_KEY=

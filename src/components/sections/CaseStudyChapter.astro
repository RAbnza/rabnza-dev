---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  dark?: boolean;
  motionId?: string;
}

const { eyebrow, title, description, dark = false, motionId } = Astro.props;
---

<section
  class:list={[
    "px-5 py-20 md:px-8 md:py-24 lg:px-12 lg:py-32",
    dark && "dark bg-night-canvas text-light-text",
  ]}
  data-case-study-chapter={motionId}
>
  <div class="container-wide">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-4" data-chapter-copy>
        <p
          class:list={[
            "font-mono text-xs tracking-[0.08em] uppercase",
            dark ? "text-lavender" : "text-violet-ink",
          ]}
        >
          {eyebrow}
        </p>

        <h2 class="mt-3 text-4xl font-semibold tracking-[-0.03em]">{title}</h2>

        <p
          class:list={[
            "mt-5 max-w-[52ch] leading-relaxed",
            dark ? "text-muted-dark" : "text-muted-foreground",
          ]}
        >
          {description}
        </p>
      </div>

      <div class="lg:col-span-7 lg:col-start-6" data-chapter-media>
        <slot />
      </div>
    </div>
  </div>
</section>

---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Icon from "@/components/ui/Icon.astro";
interface Props {
  project: CollectionEntry<"projects">;
}
const { project } = Astro.props;
const chapters = [
  {
    id: "sell",
    number: "01",
    title: "A simple sale. A careful transaction.",
    description:
      "Build an order in the interface. Behind it, the server checks stock, calculates prices, and records the sale as one complete operation.",
    detail: "Server-calculated prices · Transactional writes",
  },
  {
    id: "track",
    number: "02",
    title: "Every change leaves a trail.",
    description:
      "Receiving, sales, and adjustments become signed stock movements. Inventory is a history you can follow, with a reason behind every change.",
    detail: "Movement ledger · Traceable inventory",
  },
  {
    id: "review",
    number: "03",
    title: "The day’s work, brought into focus.",
    description:
      "Review completed sales and their line items. Role-based access keeps operational tools and management views in the right hands.",
    detail: "Daily reporting · API-enforced permissions",
  },
].map((chapter) => ({
  ...chapter,
  media: project.data.gallery.find((media) => media.role === chapter.id)!,
}));
---

<section
  id="work"
  class="flagship dark"
  data-story
  data-journey="work"
  aria-labelledby="flagship-title"
>
  <div class="flagship-light" aria-hidden="true" data-story-light></div>
  <div class="container-main">
    <header class="flagship-header">
      <div>
        <p class="eyebrow">03 / Selected work</p>
        <h2 id="flagship-title">
          TindaTrack<span>.</span>
        </h2>
        <p>
          Small-store operations.
          <br />
          Full-stack thinking.
        </p>
      </div>
      <div class="flagship-intro">
        <p>
          An inventory and sales application for small local retailers. A closer
          look at the system behind the screen.
        </p>
        <a class="button" href="/projects/tindatrack/">
          Read the case study <Icon name="ArrowUpRight" />
        </a>
      </div>
    </header>
    <nav class="chapter-nav" aria-label="TindaTrack chapters">
      {chapters.map((chapter) => (
        <a href={`#${chapter.id}`} data-chapter-link={chapter.id}>
          <span class="mono">{chapter.number}</span>
          {chapter.id}
          <Icon name="ArrowDown" size={14} />
        </a>
      ))}
    </nav>
    <div class="story-grid">
      <div class="story-chapters">
        {chapters.map((chapter) => (
          <article class="story-chapter" id={chapter.id} data-chapter>
            <div>
              <p class="eyebrow">
                {chapter.number} / {chapter.id}
              </p>
              <h3>{chapter.title}</h3>
              <p>{chapter.description}</p>
              <span class="story-detail mono">{chapter.detail}</span>
            </div>
            <figure class="story-inline-media">
              <Image
                src={chapter.media.src}
                alt={chapter.media.alt}
                widths={[480, 720, 960, 1280]}
                sizes="90vw"
                loading="lazy"
              />
              <figcaption>{chapter.media.caption}</figcaption>
            </figure>
          </article>
        ))}
      </div>
      <div class="story-stage" aria-hidden="true">
        <div class="story-stage-inner">
          {chapters.map((chapter, index) => (
            <div class="story-frame" data-frame={index}>
              <div class="window-bar">
                <span></span>
                <span></span>
                <span></span>
                <small>TindaTrack / {chapter.id}</small>
              </div>
              <Image
                src={chapter.media.src}
                alt=""
                widths={[640, 960, 1280]}
                sizes="55vw"
                loading="lazy"
              />
              <p class="story-frame-caption">
                <span class="mono">
                  {chapter.number} / {chapter.id}
                </span>
                <span>Actual application interface</span>
              </p>
            </div>
          ))}
        </div>
        <div class="story-progress">
          <span data-story-progress></span>
        </div>
        <p class="story-stage-note mono">Interface → API → PostgreSQL</p>
      </div>
    </div>
    <div class="flagship-end">
      <p>React · TypeScript · Express · PostgreSQL</p>
      <a class="text-link" href="/projects/tindatrack/#engineering">
        Go beneath the interface <Icon name="ArrowUpRight" />
      </a>
    </div>
  </div>
</section>

---
import type { LocalImageProps } from "astro:assets";

import ProjectMedia from "@/components/ui/ProjectMedia.astro";

interface Media {
  src: LocalImageProps["src"];
  alt: string;
  caption?: string;
}

interface Props {
  sell: Media;
  receipt?: Media;
  track: Media;
}

const { sell, receipt, track } = Astro.props;
---

<section class="flagship-sequence" data-tindatrack-sequence>
  <div class="flagship-stage" data-sequence-stage>
    <div
      class="flagship-dark-environment"
      data-sequence-dark
      aria-hidden="true"
    ></div>

    <div
      class="flagship-lavender-bridge"
      data-sequence-bridge
      aria-hidden="true"
    ></div>

    <section
      class="flagship-panel flagship-panel-sell px-5 py-20 md:px-8 md:py-24 lg:px-12 lg:py-32"
      data-sequence-panel="sell"
    >
      <div
        class="container-wide grid gap-10 lg:grid-cols-12 lg:items-center"
        data-sequence-layout
      >
        <div class="lg:col-span-4" data-sequence-sell-copy>
          <p class="font-mono text-xs tracking-[0.08em] text-violet-ink uppercase">
            01 — Sell
          </p>

          <h2 class="mt-3 text-4xl font-semibold tracking-[-0.03em]">
            Record the sale without trusting the client.
          </h2>

          <p class="mt-5 max-w-[52ch] leading-relaxed text-muted-foreground">
            The user builds the order in the interface, but the backend reloads
            authoritative product data, verifies inventory, and calculates the
            final prices and total before committing the transaction.
          </p>
        </div>

        <div
          class="relative lg:col-span-7 lg:col-start-6"
          data-sequence-sell-media
        >
          <ProjectMedia src={sell.src} alt={sell.alt} caption={sell.caption} />

          {receipt && (
            <div class="flagship-receipt mt-8" data-sequence-receipt>
              <ProjectMedia
                src={receipt.src}
                alt={receipt.alt}
                caption={receipt.caption}
                sizes="(max-width: 1023px) calc(100vw - 40px), 24vw"
              />
            </div>
          )}
        </div>
      </div>
    </section>

    <section
      class="flagship-panel flagship-panel-track dark px-5 py-20 text-light-text md:px-8 md:py-24 lg:px-12 lg:py-32"
      data-sequence-panel="track"
    >
      <div
        class="container-wide grid gap-10 lg:grid-cols-12 lg:items-center"
        data-sequence-layout
      >
        <div class="lg:col-span-4" data-sequence-track-copy>
          <p class="font-mono text-xs tracking-[0.08em] text-lavender uppercase">
            02 — Track
          </p>

          <h2 class="mt-3 text-4xl font-semibold tracking-[-0.03em]">
            Treat inventory as evidence, not a mutable number.
          </h2>

          <p class="mt-5 max-w-[52ch] leading-relaxed text-muted-dark">
            Inventory is derived from signed stock movements. Receipts, sales,
            and adjustments leave records explaining why each quantity changed.
          </p>
        </div>

        <div class="lg:col-span-7 lg:col-start-6" data-sequence-track-media>
          <ProjectMedia
            src={track.src}
            alt={track.alt}
            caption={track.caption}
            dark
          />
        </div>
      </div>
    </section>

    <div class="flagship-progress" data-sequence-progress aria-hidden="true">
      <span>Sell</span>

      <div class="flagship-progress-track">
        <span class="flagship-progress-fill" data-sequence-progress-fill></span>
      </div>

      <span>Track</span>
    </div>
  </div>
</section>

<style>
  .flagship-sequence {
    position: relative;
  }

  .flagship-stage {
    position: relative;
  }

  .flagship-dark-environment,
  .flagship-lavender-bridge,
  .flagship-progress {
    display: none;
  }

  .flagship-panel-track {
    background: var(--night-canvas);
  }

  [data-tindatrack-sequence][data-enhanced="true"] {
    height: 240svh;
  }

  [data-tindatrack-sequence][data-enhanced="true"] .flagship-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: clip;
    background: var(--background);
  }

  [data-tindatrack-sequence][data-enhanced="true"] .flagship-panel {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
  }

  [data-tindatrack-sequence][data-enhanced="true"] [data-sequence-layout] {
    width: 100%;
  }

  [data-tindatrack-sequence][data-enhanced="true"] .flagship-panel-track {
    background: transparent;
  }

  [data-tindatrack-sequence][data-enhanced="true"] .flagship-dark-environment {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
    background: var(--night-canvas);
    opacity: 0;
  }

  [data-tindatrack-sequence][data-enhanced="true"] .flagship-lavender-bridge {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    background: var(--lavender);
    opacity: 0;
    pointer-events: none;
  }

  [data-tindatrack-sequence][data-enhanced="true"] .flagship-receipt {
    position: absolute;
    right: -3%;
    bottom: -12%;
    width: min(38%, 18rem);
    margin-top: 0;
    z-index: 3;
  }

  [data-tindatrack-sequence][data-enhanced="true"]
    .flagship-receipt
    figcaption {
    display: none;
  }

  [data-tindatrack-sequence][data-enhanced="true"] .flagship-progress {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    z-index: 4;
    display: flex;
    width: min(22rem, calc(100% - 3rem));
    transform: translateX(-50%);
    align-items: center;
    gap: 0.75rem;
    font-family: monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    pointer-events: none;
  }

  .flagship-progress-track {
    height: 1px;
    flex: 1;
    overflow: hidden;
    background: currentColor;
    opacity: 0.3;
  }

  .flagship-progress-fill {
    display: block;
    width: 100%;
    height: 100%;
    transform: scaleX(0);
    transform-origin: left center;
    background: currentColor;
  }
</style>

---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
interface Props {
  project: CollectionEntry<"projects">;
}
const {
  project: { id, data },
} = Astro.props;
---

<article class="project-card" data-reveal>
  <a
    class="project-image-link"
    href={`/projects/${id}/`}
    aria-label={`Explore ${data.title}`}
  >
    {data.cover && (
      <Image
        src={data.cover.src}
        alt={data.cover.alt}
        widths={[480, 720, 960]}
        sizes="(min-width: 768px) 45vw, 90vw"
        loading="lazy"
      />
    )}
    <span class="project-open">
      <Icon name="ArrowUpRight" />
    </span>
  </a>
  <div class="project-card-heading">
    <h3>
      <a href={`/projects/${id}/`}>{data.title}</a>
    </h3>
    <span class="eyebrow">
      {data.type === "desktop-application"
        ? "Desktop app"
        : data.type.replaceAll("-", " ")}
    </span>
  </div>
  <p>{data.summary}</p>
  <ul class="tags">
    {data.technologies.slice(0, 4).map((technology) => (
      <li>{technology}</li>
    ))}
  </ul>
</article>

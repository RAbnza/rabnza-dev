---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import ProjectMedia from "@/components/ui/ProjectMedia.astro";
import Icon from "@/components/ui/Icon.astro";
interface Props {
  project: CollectionEntry<"projects">;
}
const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const projects = (
  await getCollection("projects", ({ data }) => data.publication.published)
).sort((a, b) => a.data.priority - b.data.priority);
const next =
  projects[
    (projects.findIndex((entry) => entry.id === project.id) + 1) %
      projects.length
  ]!;
---

<BaseLayout title={`${data.title} — Rendel Abainza`} description={data.summary}>
  <main id="main-content">
    <article>
      <header class="page-heading container-main">
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
          <a href="/">Portfolio</a>
          <span aria-hidden="true">/</span>
          <a href="/projects/">Projects</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{data.title}</span>
        </nav>
        <p class="eyebrow">
          {project.id === "tindatrack"
            ? "Flagship case study"
            : data.status === "archived" || data.status === "retrospective"
              ? "Project archive"
              : "Selected project"}
        </p>
        <h1>{data.title}</h1>
        <p class="lead">{data.summary}</p>
        <div class="actions">
          {data.links.source && (
            <a class="button" href={data.links.source}>
              View source <Icon name="ArrowUpRight" />
            </a>
          )}
          {data.links.demo && (
            <a class="button secondary" href={data.links.demo}>
              {project.id === "radmedics"
                ? "Visit website"
                : "Open live project"}{" "}
              <Icon name="ArrowUpRight" />
            </a>
          )}
        </div>
      </header>
      {data.cover && (
        <div class="container-main case-cover">
          <ProjectMedia
            src={data.cover.src}
            alt={data.cover.alt}
            caption={data.cover.caption}
            sizes="(min-width: 1280px) 1200px, 90vw"
            eager
          />
        </div>
      )}
      <div class="container-main case-grid">
        <dl class="case-facts">
          <div>
            <dt>Project context</dt>
            <dd>{data.contribution.role}</dd>
          </div>
          <div>
            <dt>Status</dt>
            <dd>{data.status.replaceAll("-", " ")}</dd>
          </div>
          <div>
            <dt>Technologies</dt>
            <dd>{data.technologies.join(" · ")}</dd>
          </div>
        </dl>
        <div class="prose">
          <h2>Project context</h2>
          <p>{data.contribution.teamContext}</p>
          <Content />
        </div>
      </div>
      <slot />
      <div class="container-main case-next">
        <a class="text-link" href="/#work">
          Back to portfolio <Icon name="ArrowRight" />
        </a>
        <a class="text-link" href={`/projects/${next.id}/`}>
          Next: {next.data.title} <Icon name="ArrowUpRight" />
        </a>
      </div>
    </article>
  </main>
</BaseLayout>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/ui/Icon.astro";
---

<BaseLayout title="Page not found — Rendel Abainza" noindex>
  <main id="main-content" class="container-main section">
    <p class="eyebrow">404 / A small detour</p>
    <h1 style="font-size:clamp(44px,7vw,80px);line-height:1.1;letter-spacing:-.04em;margin-block:24px">
      This page isn’t here.
    </h1>
    <p>
      The address may have changed. There’s still plenty of work to explore.
    </p>
    <div class="actions">
      <a class="button" href="/">
        Back home <Icon name="ArrowRight" />
      </a>
      <a class="text-link" href="/projects/">
        Browse projects <Icon name="ArrowUpRight" />
      </a>
    </div>
  </main>
</BaseLayout>

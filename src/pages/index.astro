---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout>
  <main id="main-content">
    <section class="min-h-screen px-5 py-16 md:px-8 md:py-24 lg:px-12 lg:py-32">
      <div id="motion-test" class="container-main">
        <p class="font-mono text-xs tracking-[0.08em] text-muted-foreground uppercase">
          Portfolio foundation
        </p>

        <h1 class="mt-4 max-w-4xl text-4xl font-semibold tracking-[-0.04em] text-balance sm:text-5xl lg:text-6xl">
          Useful software, thoughtfully built.
        </h1>

        <p class="mt-6 max-w-[68ch] text-lg leading-relaxed text-muted-foreground">
          The project foundation is ready. Portfolio content and major
          interactions will be implemented in later development phases.
        </p>
      </div>
    </section>
  </main>

  <script>
    import { createMotionScope } from "@/lib/motion/scope";
    import { revealElement } from "@/lib/motion/reveal";

    const root = document.querySelector<HTMLElement>("#motion-test");

    if (root) {
      const scope = createMotionScope(root, () => {
        revealElement(root);
      });

      document.addEventListener(
        "astro:before-swap",
        () => {
          scope.revert();
        },
        {
          once: true,
        },
      );
    }
  </script>
</BaseLayout>

---
import { getCollection, render, type CollectionEntry } from "astro:content";

import CaseStudyChapter from "@/components/sections/CaseStudyChapter.astro";
import ProjectMedia from "@/components/ui/ProjectMedia.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection(
    "projects",
    ({ data }) => data.publication.published,
  );

  return projects.map((project) => ({
    params: {
      id: project.id,
    },
    props: {
      project,
    },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;

const { Content } = await render(project);

const {
  title,
  summary,
  technologies,
  contribution,
  cover,
  gallery,
  links,
} = project.data;

const sellMedia = gallery.find((item) => item.role === "sell");
const receiptMedia = gallery.find((item) => item.role === "receipt");
const trackMedia = gallery.find((item) => item.role === "track");
const auditMedia = gallery.find((item) => item.role === "audit");
const reviewMedia = gallery.find((item) => item.role === "review");
---

<BaseLayout
  title={`${title} — Rendel Abainza`}
  description={summary}
>
  <main id="main-content">
    <article>
      <header class="px-5 py-20 md:px-8 md:py-24 lg:px-12 lg:py-32">
        <div class="container-main">
          <p
            class="font-mono text-xs tracking-[0.08em] text-violet-ink uppercase"
          >
            Flagship project
          </p>

          <h1
            class="mt-4 max-w-5xl text-5xl font-semibold tracking-[-0.04em] text-balance sm:text-6xl lg:text-7xl"
          >
            {title}
          </h1>

          <p
            class="mt-6 max-w-[68ch] text-lg leading-relaxed text-muted-foreground md:text-xl"
          >
            {summary}
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            {
              links.demo && (
                <a
                  href={links.demo}
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex min-h-12 items-center justify-center rounded-sm bg-primary px-5 py-3 font-medium text-primary-foreground"
                >
                  View live demo
                </a>
              )
            }

            {
              links.source && (
                <a
                  href={links.source}
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex min-h-12 items-center justify-center rounded-sm border border-input bg-background px-5 py-3 font-medium"
                >
                  View source
                </a>
              )
            }
          </div>
        </div>
      </header>

      {
        cover && (
          <div class="container-wide px-5 md:px-8 lg:px-12">
            <ProjectMedia
              src={cover.src}
              alt={cover.alt}
              caption={cover.caption}
              sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1023px) calc(100vw - 64px), min(1360px, calc(100vw - 96px))"
            />
          </div>
        )
      }

      <section class="px-5 py-20 md:px-8 md:py-24 lg:px-12 lg:py-32">
        <div class="container-main grid gap-12 lg:grid-cols-12 lg:gap-8">
          <div class="lg:col-span-4">
            <p
              class="font-mono text-xs tracking-[0.08em] text-violet-ink uppercase"
            >
              Contribution
            </p>

            <h2 class="mt-3 text-3xl font-semibold tracking-[-0.03em]">
              Built independently, end to end.
            </h2>
          </div>

          <div class="lg:col-span-7 lg:col-start-6">
            {
              contribution.teamContext && (
                <p class="text-lg leading-relaxed text-muted-foreground">
                  {contribution.teamContext}
                </p>
              )
            }

            <ul class="mt-8 space-y-4">
              {
                contribution.details.map((detail) => (
                  <li class="border-l border-divider-light pl-4 leading-relaxed">
                    {detail}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>

      <section class="px-5 py-20 md:px-8 md:py-24 lg:px-12 lg:py-32">
        <div class="container-main">
          <div class="reading-width">
            <p
              class="font-mono text-xs tracking-[0.08em] text-violet-ink uppercase"
            >
              Overview
            </p>

            <div
              class="mt-6 space-y-6 text-lg leading-relaxed text-muted-foreground"
            >
              <Content />
            </div>
          </div>
        </div>
      </section>

      {
        sellMedia && (
          <CaseStudyChapter
            eyebrow="01 — Sell"
            title="Record the sale without trusting the client."
            description="The user builds the order in the interface, but the backend reloads authoritative product data, verifies inventory, and calculates the final prices and total before committing the transaction."
          >
            <div class="space-y-8">
              <ProjectMedia
                src={sellMedia.src}
                alt={sellMedia.alt}
                caption={sellMedia.caption}
              />

              {receiptMedia && (
                <ProjectMedia
                  src={receiptMedia.src}
                  alt={receiptMedia.alt}
                  caption={receiptMedia.caption}
                  sizes="(max-width: 1023px) calc(100vw - 40px), 42vw"
                />
              )}
            </div>
          </CaseStudyChapter>
        )
      }

      {
        trackMedia && (
          <CaseStudyChapter
            eyebrow="02 — Track"
            title="Treat inventory as evidence, not a mutable number."
            description="Inventory is derived from signed stock movements. Receipts, sales, and adjustments leave records explaining why each quantity changed."
            dark
          >
            <ProjectMedia
              src={trackMedia.src}
              alt={trackMedia.alt}
              caption={trackMedia.caption}
              dark
            />
          </CaseStudyChapter>
        )
      }

      {
        reviewMedia && (
          <CaseStudyChapter
            eyebrow="03 — Review"
            title="Bring operational history back into view."
            description="Daily sales reporting, stock movements, and audit history provide evidence that can be reviewed after the original transaction has completed."
          >
            <div class="space-y-8">
              <ProjectMedia
                src={reviewMedia.src}
                alt={reviewMedia.alt}
                caption={reviewMedia.caption}
              />

              {auditMedia && (
                <ProjectMedia
                  src={auditMedia.src}
                  alt={auditMedia.alt}
                  caption={auditMedia.caption}
                />
              )}
            </div>
          </CaseStudyChapter>
        )
      }

      <section class="px-5 py-20 md:px-8 md:py-24 lg:px-12 lg:py-32">
        <div class="container-main grid gap-12 lg:grid-cols-12">
          <div class="lg:col-span-4">
            <p
              class="font-mono text-xs tracking-[0.08em] text-violet-ink uppercase"
            >
              Technology
            </p>

            <h2 class="mt-3 text-3xl font-semibold tracking-[-0.03em]">
              Full-stack implementation.
            </h2>
          </div>

          <ul
            class="flex flex-wrap gap-2 lg:col-span-7 lg:col-start-6"
          >
            {
              technologies.map((technology) => (
                <li class="rounded-full border border-border bg-card px-3 py-2 text-sm">
                  {technology}
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </article>
  </main>
</BaseLayout>
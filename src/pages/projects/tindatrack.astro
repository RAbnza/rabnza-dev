---
import { getEntry, render } from "astro:content";

import CaseStudyChapter from "@/components/sections/CaseStudyChapter.astro";
import TindaTrackEngineering from "@/components/sections/TindaTrackEngineering.astro";
import TindaTrackFlagshipSequence from "@/components/sections/TindaTrackFlagshipSequence.astro";
import ProjectMedia from "@/components/ui/ProjectMedia.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const project = await getEntry("projects", "tindatrack");

if (!project) {
  throw new Error("TindaTrack project entry could not be found.");
}

const { Content } = await render(project);

const { title, summary, technologies, contribution, cover, gallery, links } =
  project.data;

const sellMedia = gallery.find((item) => item.role === "sell");
const receiptMedia = gallery.find((item) => item.role === "receipt");
const trackMedia = gallery.find((item) => item.role === "track");
const auditMedia = gallery.find((item) => item.role === "audit");
const reviewMedia = gallery.find((item) => item.role === "review");
---

<BaseLayout title={`${title} — Rendel Abainza`} description={summary}>
  <main id="main-content">
    <article data-tindatrack-case-study>
      <header class="px-5 py-20 md:px-8 md:py-24 lg:px-12 lg:py-32">
        <div class="container-main">
          <p class="font-mono text-xs tracking-[0.08em] text-violet-ink uppercase">
            Flagship project
          </p>

          <h1 class="mt-4 max-w-5xl text-5xl font-semibold tracking-[-0.04em] text-balance sm:text-6xl lg:text-7xl">
            {title}
          </h1>

          <p class="mt-6 max-w-[68ch] text-lg leading-relaxed text-muted-foreground md:text-xl">
            {summary}
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            {links.demo && (
              <a
                href={links.demo}
                target="_blank"
                rel="noreferrer"
                class="inline-flex min-h-12 items-center justify-center rounded-sm bg-primary px-5 py-3 font-medium text-primary-foreground"
              >
                View live demo
              </a>
            )}

            {links.source && (
              <a
                href={links.source}
                target="_blank"
                rel="noreferrer"
                class="inline-flex min-h-12 items-center justify-center rounded-sm border border-input bg-background px-5 py-3 font-medium"
              >
                View source
              </a>
            )}
          </div>
        </div>
      </header>

      {cover && (
        <div class="container-wide px-5 md:px-8 lg:px-12">
          <ProjectMedia
            src={cover.src}
            alt={cover.alt}
            caption={cover.caption}
            sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1023px) calc(100vw - 64px), min(1360px, calc(100vw - 96px))"
          />
        </div>
      )}

      <section class="px-5 py-20 md:px-8 md:py-24 lg:px-12 lg:py-32">
        <div class="container-main grid gap-12 lg:grid-cols-12 lg:gap-8">
          <div class="lg:col-span-4">
            <p class="font-mono text-xs tracking-[0.08em] text-violet-ink uppercase">
              Contribution
            </p>

            <h2 class="mt-3 text-3xl font-semibold tracking-[-0.03em]">
              Built independently, end to end.
            </h2>
          </div>

          <div class="lg:col-span-7 lg:col-start-6">
            {contribution.teamContext && (
              <p class="text-lg leading-relaxed text-muted-foreground">
                {contribution.teamContext}
              </p>
            )}

            <ul class="mt-8 space-y-4">
              {contribution.details.map((detail) => (
                <li class="border-l border-divider-light pl-4 leading-relaxed">
                  {detail}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section class="px-5 py-20 md:px-8 md:py-24 lg:px-12 lg:py-32">
        <div class="container-main">
          <div class="reading-width">
            <p class="font-mono text-xs tracking-[0.08em] text-violet-ink uppercase">
              Overview
            </p>

            <div class="mt-6 space-y-6 text-lg leading-relaxed text-muted-foreground">
              <Content />
            </div>
          </div>
        </div>
      </section>

      {sellMedia && trackMedia && (
        <TindaTrackFlagshipSequence
          sell={{
            src: sellMedia.src,
            alt: sellMedia.alt,
            caption: sellMedia.caption,
          }}
          receipt={
            receiptMedia
              ? {
                  src: receiptMedia.src,
                  alt: receiptMedia.alt,
                  caption: receiptMedia.caption,
                }
              : undefined
          }
          track={{
            src: trackMedia.src,
            alt: trackMedia.alt,
            caption: trackMedia.caption,
          }}
        />
      )}

      {reviewMedia && (
        <CaseStudyChapter
          eyebrow="03 — Review"
          motionId="review"
          title="Bring operational history back into view."
          description="Daily sales reporting, stock movements, and audit history provide evidence that can be reviewed after the original transaction has completed."
        >
          <div class="space-y-8">
            <ProjectMedia
              src={reviewMedia.src}
              alt={reviewMedia.alt}
              caption={reviewMedia.caption}
            />

            {auditMedia && (
              <ProjectMedia
                src={auditMedia.src}
                alt={auditMedia.alt}
                caption={auditMedia.caption}
              />
            )}
          </div>
        </CaseStudyChapter>
      )}

      <TindaTrackEngineering />

      <section class="px-5 py-20 md:px-8 md:py-24 lg:px-12 lg:py-32">
        <div class="container-main grid gap-12 lg:grid-cols-12">
          <div class="lg:col-span-4">
            <p class="font-mono text-xs tracking-[0.08em] text-violet-ink uppercase">
              Technology
            </p>

            <h2 class="mt-3 text-3xl font-semibold tracking-[-0.03em]">
              Full-stack implementation.
            </h2>
          </div>

          <ul class="flex flex-wrap gap-2 lg:col-span-7 lg:col-start-6">
            {technologies.map((technology) => (
              <li class="rounded-full border border-border bg-card px-3 py-2 text-sm">
                {technology}
              </li>
            ))}
          </ul>
        </div>
      </section>
    </article>
  </main>
</BaseLayout>

<script>
  import { setupCaseStudyMotion } from "@/lib/motion/case-study";
  import { setupTindaTrackSequence } from "@/lib/motion/tindatrack-sequence";

  function initializeTindaTrackMotion() {
    const root = document.querySelector<HTMLElement>(
      "[data-tindatrack-case-study]",
    );

    if (!root) {
      return;
    }

    const scopes: Array<{ revert: () => void }> = [];

    const caseStudyScope = setupCaseStudyMotion(root);

    if (caseStudyScope) {
      scopes.push(caseStudyScope);
    }

    const sequenceRoot = root.querySelector<HTMLElement>(
      "[data-tindatrack-sequence]",
    );

    if (sequenceRoot) {
      const sequenceScope = setupTindaTrackSequence(sequenceRoot);

      if (sequenceScope) {
        scopes.push(sequenceScope);
      }
    }

    if (scopes.length === 0) {
      return;
    }

    document.addEventListener(
      "astro:before-swap",
      () => {
        scopes.forEach((scope) => {
          scope.revert();
        });
      },
      { once: true },
    );
  }

  initializeTindaTrackMotion();
</script>
